          <Commands>
            <Command>
              <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].AveragePM25
 AS [Measures].[PM2 5] /
[Measures].[Total Observations], 
FORMAT_STRING = "0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT WEATHER'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].AveragePM10
 AS [Measures].[PM10] /
[Measures].[Total Observations], 
FORMAT_STRING = "0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT WEATHER'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].AverageCO
 AS [Measures].[CO] /
[Measures].[Total Observations], 
FORMAT_STRING = "0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT WEATHER'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].AverageO3
 AS [Measures].[O3] /
[Measures].[Total Observations], 
FORMAT_STRING = "0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT WEATHER'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].AverageNO2
 AS [Measures].[NO2] /
[Measures].[Total Observations], 
FORMAT_STRING = "0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT WEATHER'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].AverageSO2
 AS [Measures].[SO2] /
[Measures].[Total Observations], 
FORMAT_STRING = "0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT WEATHER'  ; </Text>
            </Command>
          </Commands>
        </MdxScript>
